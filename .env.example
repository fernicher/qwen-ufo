# --- Dominio público del sitio ---
# Lo usan las etiquetas Open Graph (la vista previa al compartir el enlace), el
# canonical, el sitemap.xml y el robots.txt, que necesitan URLs absolutas.
# Si no se define, el build usa https://qwen-ufo.vercel.app
SITE_URL=

VITE_TMDB_API_KEY=tu_api_key_aqui
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
VITE_TMDB_IMAGE_BACKDROP_URL=https://image.tmdb.org/t/p/original

# === Feed de noticias + contador de visitas (todas OPCIONALES) ===
# Se cargan en Vercel → Project → Settings → Environment Variables.
# El sitio funciona sin ninguna: el feed anda con Reddit + Google News + Bluesky,
# y el contador simplemente no se muestra hasta configurar Upstash.

# --- Contador de visitas por país ---
# Upstash Redis (plan gratis): https://upstash.com → creá una base "Redis" y copiá las
# credenciales REST. Sin estas dos, /api/hits responde { configured:false } y el bloque
# de visitas queda oculto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Feed: fuente YouTube (opcional) ---
# Clave gratis de "YouTube Data API v3" (https://console.cloud.google.com).
# Reddit, Google News y Bluesky no necesitan ninguna clave.
YOUTUBE_API_KEY=
